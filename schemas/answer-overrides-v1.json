{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "profileEnabled": {
      "type": "boolean"
    },
    "autoRecord": {
      "type": "boolean"
    },
    "adaptiveResponse": {
      "type": "boolean"
    },
    "suppressKnownConcepts": {
      "type": "boolean"
    },
    "progressiveDetails": {
      "type": "boolean"
    },
    "preferArtifacts": {
      "type": "boolean"
    },
    "panelEnabled": {
      "type": "boolean"
    },
    "verbosity": {
      "type": "string",
      "enum": [
        "auto",
        "detailed",
        "conclusion-only"
      ]
    },
    "excludedModalities": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "diagram",
          "table",
          "chart",
          "code",
          "artifact"
        ]
      }
    },
    "discussionOnly": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "$id": "urn:shutong:answer-overrides-v1"
}
