{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "trunk": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "reviewTrunk": {
      "type": "boolean"
    },
    "criticalPoints": {
      "default": [],
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 800
      }
    },
    "details": {
      "default": [],
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "parentId": {
            "type": "string",
            "maxLength": 64
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "requiredInTrunk": {
            "description": "Concise decision-changing conditions from this detail, copied verbatim into trunk; [] when none. Not routine steps.",
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 800
            }
          },
          "concepts": {
            "default": [],
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "evidence": {
                  "type": "string",
                  "maxLength": 1000
                }
              },
              "required": [
                "id",
                "name",
                "evidence"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "body",
          "concepts"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "criticalPoints",
    "details"
  ],
  "additionalProperties": false,
  "$id": "urn:shutong:presentation-v1"
}
